+void PlaybackEngine::prepareVideoDecoderChange()
+{
+    const auto position = currentPosition(false);
+    m_codecContexts[QPlatformMediaPlayer::VideoStream] = {};
+    m_timeController.sync(m_currentLoopOffset.loopStartTimeUs.asDuration() + position);
+    m_seekPending = true;
 }
 
