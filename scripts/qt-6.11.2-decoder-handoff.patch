+bool PlaybackEngine::eventFilter(QObject *watched, QEvent *event)
+{
+    if (watched == m_videoSink && event->type() == QEvent::DynamicPropertyChange
+        && static_cast<QDynamicPropertyChangeEvent *>(event)->propertyName()
+                == VideoDecoderHandoff::softwareDecodingProperty) {
+        prepareVideoDecoderChange();
+        forceUpdate();
+    }
+    return QObject::eventFilter(watched, event);
+}
