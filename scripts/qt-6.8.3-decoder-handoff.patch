+bool PlaybackEngine::eventFilter(QObject *watched, QEvent *event)
+{
+    if (watched == m_videoSink && event->type() == QEvent::DynamicPropertyChange
+        && static_cast<QDynamicPropertyChangeEvent *>(event)->propertyName()
+                == VideoDecoderHandoff::softwareDecodingProperty) {
+        prepareVideoDecoderChange();
+        forceUpdate();
+    }
+    return QObject::eventFilter(watched, event);
+}
+
+void PlaybackEngine::prepareVideoDecoderChange()
+{
+    const auto &video = m_renderers[QPlatformMediaPlayer::VideoStream];
+    const auto offset = m_currentLoopOffset.loopStartTimeUs.asDuration();
+    // Audio can lag behind the visible frame when paused.
+    const auto position = m_state == QMediaPlayer::PausedState && video
+            ? boundPosition(video->lastPosition() - offset) : currentPosition(false);
+    m_codecContexts[QPlatformMediaPlayer::VideoStream] = {};
+    m_timeController.sync(offset + position);
+    m_seekPending = true;
 }
 
