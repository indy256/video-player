file(REMOVE "${TEST_LOG}")
execute_process(COMMAND "${TEST_EXECUTABLE}" -o "${TEST_LOG},txt" RESULT_VARIABLE result)
if(EXISTS "${TEST_LOG}")
    file(READ "${TEST_LOG}" output)
    message("${output}")
else()
    message("QtTest did not create its log: ${TEST_LOG}")
endif()
if(NOT result STREQUAL "0")
    message(FATAL_ERROR "player_tests failed: ${result}")
endif()
