# Only public headers are needed: the indexer loads Qt's FFmpeg 7 runtime.
include(FetchContent)
if(POLICY CMP0135)
    cmake_policy(SET CMP0135 NEW)
endif()
FetchContent_Declare(ffmpeg_headers
    URL https://codeload.github.com/FFmpeg/FFmpeg/tar.gz/refs/tags/n7.1.5
    URL_HASH SHA256=e3963a50831c985933e1a625ed566ec4c7adb5c012c34fa9f84438e1d61bdacc)
FetchContent_MakeAvailable(ffmpeg_headers)
# Public FFmpeg headers include this generated byte-order header.
include(TestBigEndian)
test_big_endian(ffmpeg_big_endian)
file(WRITE "${ffmpeg_headers_BINARY_DIR}/libavutil/avconfig.h"
    "#define AV_HAVE_BIGENDIAN ${ffmpeg_big_endian}\n#define AV_HAVE_FAST_UNALIGNED 0\n")
